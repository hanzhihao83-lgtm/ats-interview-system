{
  "name": "supplier-recruitment-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "test:server": "node server/interviewReminderService.test.mjs",
    "test": "node --import tsx --test server/recruitmentCore.test.ts server/autoDashboardParser.test.ts && npm run test:server",
    "test:auto-dashboard": "node --import tsx --test server/autoDashboardParser.test.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && cp server/*.mjs dist-server/server/ && node --check server/kimClient.mjs && node --check server/interviewReminderService.mjs",
    "start:server": "node dist-server/server/index.js",
    "build:all": "npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/checkDatabase.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@prisma/client": "^6.19.3",
    "antd": "^5.27.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "dotenv": "^17.4.2",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
