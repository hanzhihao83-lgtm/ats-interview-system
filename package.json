{
  "name": "supplier-recruitment-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "dev:server": "tsx server/index.ts",
    "test:server": "node server/interviewReminderService.test.mjs",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && node --check server/kimClient.mjs && node --check server/interviewReminderService.mjs",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^5.27.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "dotenv": "^17.4.2",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
