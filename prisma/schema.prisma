generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  PLATFORM_ADMIN
  DEPARTMENT_MANAGER
  INTERNAL_RECRUITER
  VIDEO_RECRUITER
  AUDIO_RECRUITER
  SUPPLIER_ADMIN
  SUPPLIER_VIDEO_RECRUITER
  SUPPLIER_AUDIO_RECRUITER
  SUPPLIER_RECRUITER
}

enum BusinessLine {
  VIDEO
  AUDIO
  UNCLASSIFIED
}

enum ImportTaskStatus {
  UPLOADED
  PARSING
  WAITING_MAPPING
  VALIDATING
  WAITING_CONFIRMATION
  IMPORTING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum ValidationStatus {
  VALID
  WARNING
  INVALID
}

enum DuplicateLevel {
  NONE
  EXACT
  HIGH_SUSPECT
  SAME_NAME_DIFFERENT_PERSON
  MANUAL_REVIEW
}

enum HandlingAction {
  CREATE
  SKIP
  UPDATE
  MERGE
  MANUAL_REVIEW
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  SKIPPED
  FAILED
  MANUAL_REVIEW
}

enum InterviewFeedbackStatus {
  DRAFT
  SUBMITTED
  OVERDUE
}

enum OfferStatus {
  PENDING_INITIATION
  SENT
  CANDIDATE_CONFIRMED
  REJECTED
  EXPIRED
}

enum LevelAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum OnboardingResult {
  PENDING
  CONFIRMED
  DECLINED
}

enum ReceptionTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SchedulingRequestStatus {
  PENDING
  BOOKED
  EXPIRED
  CANCELLED
}

model Supplier {
  id               String                 @id @default(cuid())
  name             String
  code             String                 @unique
  status           RecordStatus           @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  candidates       Candidate[]
  applications     CandidateApplication[]
  interviews       Interview[]
  users            User[]
  importTasks      CandidateImportTask[]  @relation("ImportTaskSupplier")
  importedDatasets ImportedDataset[]      @relation("ImportedDatasetSupplier")

  @@index([name])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole
  supplierId   String?
  status       RecordStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  supplier Supplier?     @relation(fields: [supplierId], references: [id])
  sessions AuthSession[]

  @@index([supplierId])
  @@index([role, status])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model JobPosition {
  id               String                 @id @default(cuid())
  name             String
  projectName      String?
  department       String?
  feedbackTemplate Json?
  status           RecordStatus           @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  candidates       Candidate[]
  applications     CandidateApplication[]

  @@index([name])
}

model Candidate {
  id                   String                    @id @default(cuid())
  candidateNo          String                    @unique
  name                 String
  normalizedName       String
  phone                String?
  phoneNormalized      String?
  phoneMasked          String?
  email                String?
  emailNormalized      String?
  emailMasked          String?
  supplierId           String
  positionId           String
  projectName          String?
  university           String?
  normalizedUniversity String?
  major                String?
  highestEducation     String?
  graduationYear       Int?
  isFreshGraduate      Boolean?
  resumeSubmitDate     DateTime?
  resumeResult         String?
  currentStatus        String
  expectedEntryDate    DateTime?
  actualEntryDate      DateTime?
  leaveDate            DateTime?
  remark               String?
  source               String?
  createdAt            DateTime                  @default(now())
  createdBy            String?
  updatedAt            DateTime                  @updatedAt
  updatedBy            String?
  deletedAt            DateTime?
  supplier             Supplier                  @relation(fields: [supplierId], references: [id])
  position             JobPosition               @relation(fields: [positionId], references: [id])
  statusEvents         CandidateStatusEvent[]
  interviews           Interview[]
  operationLogs        OperationLog[]
  importRows           CandidateImportRow[]
  applications         CandidateApplication[]
  screeningResults     AIResumeScreeningResult[]

  @@index([normalizedName])
  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@index([supplierId])
  @@index([positionId])
  @@index([currentStatus])
  @@index([resumeSubmitDate])
}

model CandidateApplication {
  id                String       @id @default(cuid())
  applicationNo     String       @unique
  candidateId       String
  supplierId        String
  businessLine      BusinessLine
  positionId        String?
  projectName       String?
  currentStatus     String
  resumeResult      String?
  interviewResult   String?
  expectedEntryDate DateTime?
  actualEntryDate   DateTime?
  businessData      Json?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  candidate          Candidate                    @relation(fields: [candidateId], references: [id])
  supplier           Supplier                     @relation(fields: [supplierId], references: [id])
  position           JobPosition?                 @relation(fields: [positionId], references: [id])
  interviews         Interview[]
  screeningResults   AIResumeScreeningResult[]
  kimNotifications   KimNotificationLog[]
  meetingRecords     TencentMeetingRecord[]
  statusEvents       ApplicationStatusEvent[]
  conclusion         InterviewConclusion?
  offers             Offer[]
  levelAdjustments   JobLevelAdjustment[]
  onboarding         OnboardingConfirmation?
  receptionTask      ReceptionTask?
  schedulingRequests InterviewSchedulingRequest[]

  @@index([candidateId])
  @@index([supplierId])
  @@index([businessLine])
  @@index([supplierId, businessLine])
  @@index([businessLine, currentStatus])
  @@index([supplierId, businessLine, currentStatus])
}

model CandidateStatusEvent {
  id          String    @id @default(cuid())
  candidateId String
  status      String
  effectiveAt DateTime
  operator    String?
  remark      String?
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId, effectiveAt])
}

model Interview {
  id                 String                 @id @default(cuid())
  candidateId        String
  applicationId      String?
  supplierId         String?
  businessLine       BusinessLine?
  round              Int                    @default(1)
  roundName          String?
  interviewer        String?
  scheduledStartTime DateTime
  scheduledEndTime   DateTime?
  result             String?
  status             String
  meetingProvider    String?
  meetingId          String?
  meetingUrl         String?
  feedback           String?
  feedbackDueAt      DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  candidate          Candidate              @relation(fields: [candidateId], references: [id])
  application        CandidateApplication?  @relation(fields: [applicationId], references: [id])
  supplier           Supplier?              @relation(fields: [supplierId], references: [id])
  kimNotifications   KimNotificationLog[]
  meetingRecords     TencentMeetingRecord[]
  feedbackRecord     InterviewFeedback?

  @@index([candidateId])
  @@index([applicationId])
  @@index([supplierId, businessLine])
  @@index([scheduledStartTime])
}

model CandidateImportTask {
  id                String               @id @default(cuid())
  taskNo            String               @unique
  originalFileName  String
  storedFileName    String
  fileHash          String
  fileSize          Int
  sheetName         String?
  totalRows         Int                  @default(0)
  validRows         Int                  @default(0)
  warningRows       Int                  @default(0)
  invalidRows       Int                  @default(0)
  duplicateRows     Int                  @default(0)
  importedRows      Int                  @default(0)
  skippedRows       Int                  @default(0)
  failedRows        Int                  @default(0)
  status            ImportTaskStatus     @default(UPLOADED)
  fieldMapping      Json?
  uploadedBy        String?
  defaultSupplierId String?
  defaultPositionId String?
  supplierId        String?
  businessLine      BusinessLine?
  uploadedAt        DateTime             @default(now())
  confirmedAt       DateTime?
  completedAt       DateTime?
  errorMessage      String?
  rows              CandidateImportRow[]
  logs              OperationLog[]
  fileRecord        ImportFileRecord?
  supplier          Supplier?            @relation("ImportTaskSupplier", fields: [supplierId], references: [id])

  @@index([fileHash])
  @@index([uploadedAt])
  @@index([supplierId])
  @@index([businessLine])
}

model CandidateImportRow {
  id                  String              @id @default(cuid())
  taskId              String
  rowNumber           Int
  rawData             Json
  normalizedData      Json
  name                String?
  phoneMasked         String?
  supplierName        String?
  positionName        String?
  university          String?
  validationStatus    ValidationStatus    @default(INVALID)
  errors              Json
  warnings            Json
  duplicateLevel      DuplicateLevel      @default(NONE)
  duplicateReasons    Json
  matchedCandidateIds Json
  handlingAction      HandlingAction      @default(CREATE)
  importStatus        ImportRowStatus     @default(PENDING)
  importedCandidateId String?
  failureReason       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  task                CandidateImportTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  importedCandidate   Candidate?          @relation(fields: [importedCandidateId], references: [id])

  @@unique([taskId, rowNumber])
  @@index([taskId, validationStatus])
  @@index([taskId, duplicateLevel])
}

model OperationLog {
  id            String               @id @default(cuid())
  module        String
  action        String
  candidateId   String?
  importTaskId  String?
  applicationId String?
  supplierId    String?
  businessLine  BusinessLine?
  oldValue      Json?
  newValue      Json?
  operator      String?
  operatorId    String?
  reason        String?
  operatedAt    DateTime             @default(now())
  candidate     Candidate?           @relation(fields: [candidateId], references: [id])
  importTask    CandidateImportTask? @relation(fields: [importTaskId], references: [id])

  @@index([candidateId])
  @@index([importTaskId])
  @@index([operatedAt])
  @@index([applicationId])
  @@index([supplierId, businessLine])
}

model ApplicationStatusEvent {
  id            String   @id @default(cuid())
  applicationId String
  fromStatus    String?
  toStatus      String
  operatorId    String
  operatorName  String
  reason        String
  occurredAt    DateTime @default(now())

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@index([operatorId, occurredAt])
}

model InterviewFeedback {
  id              String                  @id @default(cuid())
  interviewId     String                  @unique
  templateVersion String
  dimensionScores Json
  comment         String
  status          InterviewFeedbackStatus @default(DRAFT)
  dueAt           DateTime
  submittedById   String?
  submittedByName String?
  submittedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([submittedById, submittedAt])
}

model InterviewConclusion {
  id            String   @id @default(cuid())
  applicationId String   @unique
  finalResult   String
  finalLevel    String?
  roundSummary  Json
  decidedById   String
  decidedByName String
  decidedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([decidedById, decidedAt])
}

model Offer {
  id                   String      @id @default(cuid())
  applicationId        String
  status               OfferStatus @default(PENDING_INITIATION)
  initiatedById        String
  initiatedByName      String
  sentById             String?
  sentByName           String?
  sentAt               DateTime?
  candidateRespondedAt DateTime?
  expiredAt            DateTime?
  rejectedReason       String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([status, updatedAt])
}

model JobLevelAdjustment {
  id              String                @id @default(cuid())
  applicationId   String
  requestedLevel  String
  reason          String
  status          LevelAdjustmentStatus @default(PENDING)
  requestedById   String
  requestedByName String
  reviewedById    String?
  reviewedByName  String?
  reviewComment   String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([status, createdAt])
}

model OnboardingConfirmation {
  id              String           @id @default(cuid())
  applicationId   String           @unique
  result          OnboardingResult @default(PENDING)
  entryDate       DateTime?
  confirmedById   String
  confirmedByName String
  note            String?
  confirmedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ReceptionTask {
  id              String              @id @default(cuid())
  applicationId   String              @unique
  assigneeId      String?
  assigneeName    String
  status          ReceptionTaskStatus @default(PENDING)
  dueAt           DateTime
  createdById     String
  createdByName   String
  completedById   String?
  completedByName String?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  application CandidateApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  checklist   ReceptionChecklistItem[]

  @@index([status, dueAt])
  @@index([assigneeId, status])
}

model ReceptionChecklistItem {
  id              String    @id @default(cuid())
  taskId          String
  title           String
  required        Boolean   @default(true)
  completed       Boolean   @default(false)
  completedById   String?
  completedByName String?
  completedAt     DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task ReceptionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  module    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, name])
  @@index([userId, module])
}

model InterviewSchedulingRequest {
  id            String                  @id @default(cuid())
  applicationId String
  tokenHash     String                  @unique
  interviewer   String
  round         Int                     @default(1)
  roundName     String
  proposedSlots Json
  bookedSlot    Json?
  status        SchedulingRequestStatus @default(PENDING)
  expiresAt     DateTime
  bookedAt      DateTime?
  createdById   String
  createdByName String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([status, expiresAt])
}

model ImportFileRecord {
  id          String              @id @default(cuid())
  taskId      String              @unique
  fileHash    String
  contentType String
  storagePath String
  createdAt   DateTime            @default(now())
  cleanedAt   DateTime?
  task        CandidateImportTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([fileHash])
}

model ImportedDataset {
  id               String        @id @default(cuid())
  name             String
  originalFileName String
  storedFileName   String
  fileHash         String
  status           String
  progress         Int           @default(0)
  statusMessage    String?
  totalSheets      Int           @default(0)
  processedSheets  Int           @default(0)
  candidateCount   Int           @default(0)
  supplierCount    Int           @default(0)
  warningCount     Int           @default(0)
  dashboardId      String?
  createdBy        String
  supplierId       String?
  businessLine     BusinessLine?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  candidates ImportedCandidate[]
  suppliers  ImportedSupplierSummary[]
  dashboard  GeneratedDashboard?
  supplier   Supplier?                 @relation("ImportedDatasetSupplier", fields: [supplierId], references: [id])

  @@index([fileHash])
  @@index([createdAt])
  @@index([supplierId])
  @@index([businessLine])
}

model ImportedCandidate {
  id                 String    @id @default(cuid())
  datasetId          String
  name               String
  supplier           String?
  businessType       String?
  resumeFile         String?
  interviewTimeRaw   String?
  interviewStartTime DateTime?
  interviewEndTime   DateTime?
  meetingCode        String?
  meetingUrl         String?
  meetingTextRaw     String?
  interviewResult    String?
  level              String?
  interviewer        String?
  interviewComment   String?
  entryDate          DateTime?
  entryStatus        String?
  sourceSheet        String
  sourceRow          Int
  createdAt          DateTime  @default(now())

  dataset ImportedDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([supplier])
  @@index([businessType])
  @@index([interviewResult])
  @@index([entryStatus])
  @@index([interviewStartTime])
}

model ImportedSupplierSummary {
  id                   String   @id @default(cuid())
  datasetId            String
  supplier             String
  videoResumeCount     Int?
  audioResumeCount     Int?
  videoInterviewPassed Int?
  videoConfirmedEntry  Int?
  videoActualEntry     Int?
  audioInterviewPassed Int?
  audioConfirmedEntry  Int?
  audioActualEntry     Int?
  status               String?
  remark               String?
  sourceSheet          String
  createdAt            DateTime @default(now())

  dataset ImportedDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([supplier])
}

model GeneratedDashboard {
  id           String        @id @default(cuid())
  datasetId    String        @unique
  name         String
  businessLine BusinessLine?
  config       Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  dataset ImportedDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([businessLine])
}

model AIResumeScreeningResult {
  id                 String       @id @default(cuid())
  candidateId        String
  applicationId      String
  businessLine       BusinessLine
  jobId              String?
  score              Int
  matchedPoints      Json
  missingPoints      Json
  riskPoints         Json
  interviewQuestions Json
  recommendedLevel   String?
  confidence         Float?
  promptVersion      String?
  createdAt          DateTime     @default(now())

  candidate   Candidate            @relation(fields: [candidateId], references: [id])
  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([businessLine])
}

model KimNotificationLog {
  id             String       @id @default(cuid())
  applicationId  String
  interviewId    String?
  supplierId     String
  businessLine   BusinessLine
  status         String
  messageSummary String?
  errorMessage   String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   Interview?           @relation(fields: [interviewId], references: [id])

  @@index([applicationId])
  @@index([supplierId, businessLine])
  @@index([interviewId])
}

model TencentMeetingRecord {
  id            String       @id @default(cuid())
  applicationId String
  interviewId   String?
  supplierId    String
  businessLine  BusinessLine
  meetingCode   String?
  meetingUrl    String?
  providerId    String?
  status        String
  interviewer   String?
  scheduledAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview   Interview?           @relation(fields: [interviewId], references: [id])

  @@index([applicationId])
  @@index([supplierId, businessLine])
  @@index([interviewId])
  @@index([scheduledAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  requestedScope Json?
  effectiveScope Json?
  result         String
  reason         String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([result, createdAt])
}
